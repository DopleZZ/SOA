embed-server --std-out=echo

batch
/subsystem=elytron/key-store=shopKeyStore:add(path=shop-keystore.jks, relative-to=jboss.server.config.dir, credential-reference={clear-text=changeit}, type=JKS)
/subsystem=elytron/key-manager=shopKeyManager:add(key-store=shopKeyStore, credential-reference={clear-text=changeit})
/subsystem=elytron/server-ssl-context=shopSslContext:add(key-manager=shopKeyManager, protocols=["TLSv1.3","TLSv1.2"])
run-batch

if (outcome == failed) of /subsystem=undertow/server=default-server/https-listener=https:read-resource
    /subsystem=undertow/server=default-server/https-listener=https:add(socket-binding=https, ssl-context=shopSslContext, enabled=true)
else
    /subsystem=undertow/server=default-server/https-listener=https:write-attribute(name=ssl-context, value=shopSslContext)
end-if

batch
/subsystem=ejb3/service=remote:remove
/subsystem=remoting/http-connector=http-remoting-connector:remove
/subsystem=undertow/server=default-server/http-listener=default:remove
/socket-binding-group=standard-sockets/socket-binding=http:remove

/system-property=vehicle.service.baseUrl:add(value="https://localhost:8443")
/system-property=vehicle.service.truststore.path:add(value="${jboss.server.config.dir}/vehicle-truststore.jks")
/system-property=vehicle.service.truststore.password:add(value="changeit")
run-batch

stop-embedded-server
